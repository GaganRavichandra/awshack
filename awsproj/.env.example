# 4clique Environment Configuration Template
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
VITE_AWS_LAMBDA_URL=http://127.0.0.1:8000
VITE_LOCATIONIQ_TOKEN=pk.your_locationiq_token_here

